# .env.local — Kopieer dit bestand naar .env.local en vul de waarden in
# NOOIT naar GitHub pushen! (.gitignore heeft al .env.local)

# ── Supabase ─────────────────────────────────────
# Vind je in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://jouwproject.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGc...jouw-anon-key

# ⚠️ GEHEIM — NOOIT met VITE_ prefix, NOOIT naar de browser sturen!
# Nodig voor: echte accountverwijdering (GDPR recht op vergetelheid)
# Vind je in: Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...jouw-service-role-key

# ── Vercel KV (voor Ko-fi tokens & rate limiting) ─
# Automatisch ingevuld door Vercel als je KV inschakelt
KV_URL=redis://...
KV_REST_API_URL=https://...
KV_REST_API_TOKEN=...
KV_REST_API_READ_ONLY_TOKEN=...

# ── AI Tutor — provider switch ───────────────────
# Kies welke AI de tutor aandrijft. Alleen deze regel aanpassen — geen
# code wijzigen, gewoon opnieuw deployen op Vercel.
#   claude  (default) → vult ANTHROPIC_API_KEY hieronder in
#   gemini             → vult GEMINI_API_KEY hieronder in
AI_PROVIDER=claude

# ── Anthropic (nodig als AI_PROVIDER=claude) ─────
ANTHROPIC_API_KEY=sk-ant-...
# Optioneel: ander model zonder code aan te passen (default: claude-haiku-4-5-20251001)
# CLAUDE_MODEL=claude-haiku-4-5-20251001

# ── Google Gemini (nodig als AI_PROVIDER=gemini) ─
# Key ophalen via https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
# Optioneel: ander model zonder code aan te passen (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash

# ── Ko-fi Webhook verificatie ────────────────────
# ⚠️ VERPLICHT sinds de audit-fix: zonder deze variabele weigert de
# webhook ALLE Ko-fi betalingen (fail-closed, voor je veiligheid).
# Zet 'm in Vercel → Project → Settings → Environment Variables.
# Vind je in: Ko-fi Dashboard → Settings → API → Verification Token
KOFI_VERIFICATION_TOKEN=jouw-kofi-token
KOFI_USERNAME=jouw-kofi-username
PREMIUM_PRICE_EUR=4.00
PREMIUM_DAYS=30

# ── PayPal (niet actief — later te gebruiken) ────
PAYPAL_CLIENT_ID=jouw-paypal-client-id
PAYPAL_RECEIVER_EMAIL=jouw@email.com

# ── App URL (voor CORS) ──────────────────────────
APP_ORIGIN=https://langoaiapp.vercel.app
VITE_APP_ORIGIN=https://langoaiapp.vercel.app
# Zet dit op jouw ECHTE Vercel-URL (bijv. https://langoai-two.vercel.app)
FRONTEND_ORIGIN=https://langoaiapp.vercel.app
